{
  "name": "next-route-guard",
  "version": "0.2.0",
  "description": "Auth guard and route utilities for Next.js App Router",
  "author": "Lupu Claudiu <lupuclaudiuandrei@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lupuc/next-route-guard"
  },
  "homepage": "https://github.com/lupuc/next-route-guard#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "keywords": [
    "nextjs",
    "middleware",
    "auth",
    "typescript",
    "app-router"
  ],
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=18.18"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "better-auth": ">=1.0.0",
    "next-auth": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": true
    },
    "next-auth": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "next": "^15.3.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4",
    "zod": "^3.25.28"
  }
}
